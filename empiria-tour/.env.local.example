# ── Supabase ───────────────────────────────────────────────────────────────
# From Supabase → Project Settings → API, for the TOURS project
# (wnaleobzkoukdzlruouu). Never the Empiria-01 project.
SUPABASE_URL=
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site ───────────────────────────────────────────────────────────────────
# Where Stripe sends travellers back to. Localhost is detected automatically in
# development, so this only has to be right in production.
NEXT_PUBLIC_TOUR_URL=

# ── Stripe ─────────────────────────────────────────────────────────────────
# SERVER ONLY, both of them. No NEXT_PUBLIC_ prefix, ever — the secret key can
# read and refund every charge on the account.
#
# STRIPE_SECRET_KEY   Developers → API keys → Secret key.
#                     sk_test_… while testing, sk_live_… when Empiria hands
#                     over their account. The booking page shows a "test mode"
#                     badge whenever it sees sk_test_, so nobody demos a live
#                     charge by accident.
#
# STRIPE_WEBHOOK_SECRET  The signing secret for THIS endpoint, not the account.
#                     Local:      stripe listen --forward-to localhost:3000/api/webhooks/stripe
#                                 prints whsec_… when it starts.
#                     Deployed:   Developers → Webhooks → add endpoint
#                                 https://your-domain/api/webhooks/stripe
#                                 then reveal its signing secret.
#                     Without it the webhook returns 503 and no booking is ever
#                     marked paid — which is the safe failure, not a silent one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (Part C) ────────────────────────────────────────────────────────
# The outbox works without these; messages queue and go out once the sending
# domain verifies. EMAIL_FROM must be on a domain with the DNS records in place
# — mail from an unverified domain lands in spam, which for a booking
# confirmation is worse than not sending.
# RESEND_API_KEY=
# EMAIL_FROM="Empiria Tours <bookings@example.com>"

# Where "new booking" alerts go. Falls back to the public contact address in
# platform settings.
# ADMIN_ALERT_EMAIL=
# Used to build the admin deep-link inside those alerts.
# ADMIN_URL=http://localhost:3001

# Shared secret for POST /api/email/tick, which drains the outbox and runs the
# reminder scan. Unset means the endpoint returns 404 — closed, not open.
# CRON_SECRET=

# ── Amazon SES (the contact form) ──────────────────────────────────────────
# The contact page sends straight to the contact address in Platform settings
# and stores nothing. All four are needed, all server-only, none NEXT_PUBLIC_.
# Without them the form renders with Send disabled and says so.
#
# AWS_SES_REGION         e.g. ca-central-1 — the region the identity is verified in.
# AWS_ACCESS_KEY_ID      an IAM user or role allowed ses:SendEmail, nothing else.
# AWS_SECRET_ACCESS_KEY
# SES_FROM_EMAIL         a sender SES has verified: "Empiria Tours <hello@…>".
#
# A new SES account is in the sandbox and may only send TO verified addresses,
# so the contact address must be verified in SES too until AWS grants
# production access — otherwise every send fails with "not verified".
# AWS_SES_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=

# ── Analytics (Part F) ─────────────────────────────────────────────────────
# One or the other; GTM wins if both are set. Neither loads until the visitor
# accepts the consent banner, and lib/analytics.ts sends nothing until then.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Bot protection (Part F) ────────────────────────────────────────────────
# Cloudflare Turnstile, on the contact form, the partner application and the
# booking flow. Both keys or neither: the site key draws the widget, the
# secret verifies it. Unset, the forms keep only their honeypot.
# Cloudflare's dummy pair for a local run — the widget always passes:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Cross-app addresses ────────────────────────────────────────────────────
# Where an approved partner signs in. Linked from /partners; defaults to the
# production domain. The Tours admin console is deliberately not linked from
# anywhere public, so it needs no NEXT_PUBLIC_ entry.
# NEXT_PUBLIC_PARTNER_URL=http://localhost:3002
# The Tours admin console. Distinct from the Events platform's admin — surfaced
# only inside the account menu of somebody who already holds a staff role.
# NEXT_PUBLIC_TOUR_ADMIN_URL=http://localhost:3001
