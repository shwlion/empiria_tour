# ── Supabase ───────────────────────────────────────────────────────────────
# From Supabase → Project Settings → API, for the TOURS project
# (wnaleobzkoukdzlruouu). Never the Empiria-01 project.
SUPABASE_URL=
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site ───────────────────────────────────────────────────────────────────
# Where Stripe sends travellers back to. Localhost is detected automatically in
# development, so this only has to be right in production.
NEXT_PUBLIC_TOUR_URL=

# ── Stripe ─────────────────────────────────────────────────────────────────
# SERVER ONLY, both of them. No NEXT_PUBLIC_ prefix, ever — the secret key can
# read and refund every charge on the account.
#
# STRIPE_SECRET_KEY   Developers → API keys → Secret key.
#                     sk_test_… while testing, sk_live_… when Empiria hands
#                     over their account. The booking page shows a "test mode"
#                     badge whenever it sees sk_test_, so nobody demos a live
#                     charge by accident.
#
# STRIPE_WEBHOOK_SECRET  The signing secret for THIS endpoint, not the account.
#                     Local:      stripe listen --forward-to localhost:3000/api/webhooks/stripe
#                                 prints whsec_… when it starts.
#                     Deployed:   Developers → Webhooks → add endpoint
#                                 https://your-domain/api/webhooks/stripe
#                                 then reveal its signing secret.
#                     Without it the webhook returns 503 and no booking is ever
#                     marked paid — which is the safe failure, not a silent one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (Part C, not built yet) ─────────────────────────────────────────
# RESEND_API_KEY=
