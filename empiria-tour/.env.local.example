# Supabase (new project for the tour app) — server-side service role key.
# The app runs without these (design shell); set them to load real data.
SUPABASE_URL=
SUPABASE_KEY=

# Cross-app base URLs (optional — sensible production defaults in lib/urls.ts).
NEXT_PUBLIC_TOUR_URL=http://localhost:3000
